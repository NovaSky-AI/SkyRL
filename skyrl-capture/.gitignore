__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.claude/worktrees/
*.egg-info/
dist/
build/
/data/
/spool/
/objects/
/capture-data/
/icap-data/
# The PostgreSQL binaries the embedded server downloads. Cached beside the data
# directory, which lands here whenever CAPTURE_DATA_DIR is left at its default.
/.skyrl-capture-postgres/
# Record directories and the CI verification artifact: a record is data a run
# produced, not source.
/traces/
/ci-traces/
# A session report, written for a reader rather than for the repo.
/report.md
.bench/
*.log
.env

# Export artifacts. These are generated by `skyrl-capture export` and are often written
# next to the scripts that produced them; they are data, not source.
*.jsonl
*.jsonl.gz
*.jsonl.zst
*.tar
*.tar.gz
manifest.json
# The viewer has no dependencies and no build; if either appears, it is a
# mistake rather than something to commit.
/viewer/node_modules/
/viewer/package-lock.json
