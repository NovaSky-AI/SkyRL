+    def stage_adapter_tensors(
+        self,
+        lora_name: str,
+        tensors: dict[str, torch.Tensor],
+        peft_config: dict,
+    ) -> None:
+        """Stage an adapter's tensors for a later ``memory://<lora_name>`` load.
+
+        ``tensors`` are PEFT-format adapter weights (the contents of
+        ``adapter_model.safetensors``) already on this worker, typically on
+        ``self.device`` after an in-process weight transfer; they are kept by
+        reference. ``peft_config`` is the ``adapter_config.json`` dict. The
+        next ``add_adapter`` for a request whose ``lora_path`` is
+        ``memory://<lora_name>`` builds the ``LoRAModel`` from them.
+        """
+        if not lora_name:
+            raise ValueError("lora_name cannot be empty")
+        if not tensors:
+            raise ValueError(f"no tensors staged for LoRA adapter {lora_name!r}")
+        self._staged_adapters[lora_name] = (dict(tensors), dict(peft_config))
+
+    def discard_staged_adapter(self, lora_name: str) -> bool:
+        return self._staged_adapters.pop(lora_name, None) is not None
+
+    def _expected_lora_modules(self) -> set[str]:
+        supported_lora_modules = self._adapter_manager.supported_lora_modules
+        packed_modules_mapping = self._adapter_manager.packed_modules_mapping
+        expected_lora_lst: list[str] = []
+        for module in supported_lora_modules:
+            if module in packed_modules_mapping:
+                expected_lora_lst.extend(packed_modules_mapping[module])
+            else:
+                expected_lora_lst.append(module)
+            if module == "experts":
+                expected_lora_lst.append(module)
+        return set(expected_lora_lst)
+
+    def _load_staged_adapter(
+        self, lora_request: LoRARequest, lora_name: str
+    ) -> LoRAModel:
+        # Kept after the load: the LoRAModel shares the staged storage when
+        # device and dtype match, and an LRU-evicted adapter can be rebuilt
+        # from it the way a directory adapter is re-read.
+        staged = self._staged_adapters.get(lora_name)
+        if staged is None:
+            raise LoRAAdapterNotFoundError(
+                lora_request.lora_name, lora_request.lora_path
+            )
+        tensors, peft_config = staged
+        peft_helper = PEFTHelper.from_dict(peft_config)
+        peft_helper.validate_legal(self.lora_config)
+
+        model = self._adapter_manager.model
+        hf_to_vllm_mapper = getattr(model, "hf_to_vllm_mapper", None)
+        if hf_to_vllm_mapper is not None:
+            hf_to_vllm_mapper = hf_to_vllm_mapper.get_unstacked_mapper()
+        lora_skip_prefixes = getattr(model, "lora_skip_prefixes", None)
+
+        self._lora_model_cls.check_unexpected_modules(
+            tensors,
+            self._expected_lora_modules(),
+            weights_mapper=hf_to_vllm_mapper,
+            skip_prefixes=lora_skip_prefixes,
+            source=lora_request.lora_path,
+        )
+        moe_ep_spec = self._adapter_manager.moe_ep_load_spec
+        if moe_ep_spec is not None:
+            tensors = {
+                k: v
+                for k, v in tensors.items()
+                if not _is_remote_expert_key(k, moe_ep_spec)
+            }
+        # Built where the tensors already are. When they match
+        # ``lora_dtype`` the per-tensor ``.to()`` is a no-op, so keys that
+        # alias one storage (shared expert adapters) keep sharing it.
+        lora = self._lora_model_cls.from_lora_tensors(
+            lora_model_id=lora_request.lora_int_id,
+            tensors=tensors,
+            peft_helper=peft_helper,
+            device=self.device,
+            dtype=self.lora_config.lora_dtype,
+            model_vocab_size=self.vocab_size,
+            weights_mapper=hf_to_vllm_mapper,
+            skip_prefixes=lora_skip_prefixes,
+        )
+        lora.is_3d_lora_weight = lora_request.is_3d_lora_weight
+        return lora
+
     def _load_adapter(self, lora_request: LoRARequest) -> LoRAModel:
+        in_memory_name = lora_request.in_memory_name
+        if in_memory_name is not None:
+            return self._load_staged_adapter(lora_request, in_memory_name)
